# reedblog 容器版 Nginx 配置（nginx:alpine 的 envsubst 模板）
#
# 渲染机制：容器启动时官方入口脚本把本模板经 envsubst 渲染到 /etc/nginx/conf.d/default.conf
# （只替换容器内已定义的env变量，$http_user_agent / $uri / $host 等 Nginx 变量原样保留）。
# 可用变量：${BACKEND_UPSTREAM} —— 后端地址，默认 backend:3000（frontend/Dockerfile 的 ENV）。
#
# 与 deploy/nginx.conf.example（裸机版）的差异：listen/server_name 容器化、代理目标走
# BACKEND_UPSTREAM、补 gzip 与静态资源缓存头；爬虫分流规则与后端 seo.rs 保持一致。

# 爬虫 / 社媒预览 UA 白名单（与 backend/src/seo.rs::is_crawler_ua 的
# CRAWLER_UA_KEYWORDS 逐项一致；大小写不敏感子串匹配）。
# ⚠️ 两边必须同步修改，否则会出现「Nginx 判为爬虫但后端不认」或反之。
map $http_user_agent $reedblog_bot {
    default 0;
    ~*(bot|crawler|spider|facebookexternalhit|twitterbot|slackbot|telegrambot|whatsapp|discordbot|googlebot|bingbot|bingpreview|baiduspider|micromessenger|wechat) 1;
}

server {
    listen 80;
    server_name _;

    # 前端静态资源 + SPA fallback
    root /usr/share/nginx/html;
    index index.html;

    # 插件/主题 zip 上传的后端上限是 32MB（backend/src/lib.rs UPLOAD_LIMIT = 32 * 1024 * 1024），
    # Nginx 需对齐，否则大 zip 在代理层就被 413。
    # 注意：后台「备份导入」的后端上限是 1GiB（backend/src/backup.rs MAX_IMPORT_BYTES），
    # 如需恢复大于 32MB 的备份 zip，把本行改为 1024m。
    client_max_body_size 32m;

    # gzip（html 默认已含在 gzip_types 之外也会压；图片/zip 已压缩，不列）
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;

    # 后端 API 反向代理（proxy_pass 不带 URI，/api/ 前缀原样透传）
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # robots.txt 由后端生成（含 Sitemap 绝对地址与后台 Disallow）
    location = /robots.txt {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # 文章 / 页面详情：命中爬虫白名单 → 后端最小 OG HTML；真人 → SPA fallback。
    # 用 error_page 418 做条件 proxy（规避 location 内 if + proxy_pass 的 "if is evil" 陷阱：
    # if 块内只放 return）。
    location ~ ^/(posts|pages)/ {
        error_page 418 = @reedblog_backend;
        if ($reedblog_bot) {
            return 418;
        }
        try_files $uri /index.html;
    }

    # Vite 构建产物带内容 hash：长缓存 + immutable
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html 不缓存（发版后立刻拿到新资源引用）；内部 fallback 也会命中这里
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 其余路径：静态文件优先，fallback SPA
    location / {
        try_files $uri /index.html;
    }

    # 爬虫分流落点：把原始 URI 原样代理给后端（含 /posts|/pages 详情与 robots.txt 之外的扩展路径）
    location @reedblog_backend {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
